[Unit]
Description=Create I2C devices for MAX98390 HDA speaker amplifiers
# i2c-setup creates the 0x39/3c/3d devices; loader then binds them all.
# i2c-setup must run BEFORE loader so devices exist when loader tries to bind.
After=sound.target
Before=max98390-hda-loader.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/max98390-hda-i2c-setup.sh start
ExecStop=/usr/local/sbin/max98390-hda-i2c-setup.sh stop
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
